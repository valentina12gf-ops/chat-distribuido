# Copiar a .env y editar:  cp .env.example .env

# Nombre corto del grupo. CAMBIAR por el número asignado por el profesor (g1, g2, g3, ...).
GROUP_NAME=g1

# URL con la que el servidor central alcanza ESTE servidor.
#   - Pruebas locales (perfil "local"):  http://server:8000
#   - Sesión de interoperabilidad:       http://IP_DE_TU_EQUIPO_EN_LA_RED_DE_LA_SALA:8000
PUBLIC_URL=http://server:8000

# URL del servidor central.
#   - Pruebas locales (central simulado dentro de Docker):  http://central:9000
#   - Sesión: la URL que publique el profesor
CENTRAL_URL=http://central:9000

# Puerto del equipo donde se publica el servidor.
PORT=8000

# Parámetros opcionales (segundos)
REGISTER_INTERVAL=30
HEARTBEAT_INTERVAL=5
HEARTBEAT_MAX_FAILS=3
RETRY_BASE_SECONDS=0.5
RETRY_MAX_SECONDS=30
